{
  "rewrites": [
    {
      "source": "/((?!api/|_next/|static/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/parse-transcript.js": {
      "includeFiles": "node_modules/pdf-parse/dist/pdf-parse/cjs/**",
      "memory": 1024,
      "maxDuration": 15
    }
  }
}
